{
  "name": "finance-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Cloudflare Worker Remote MCP adapter for Finance ontology",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "python3 ../../ontology/scripts/verify_openfin_release.py --stage predeploy",
    "deploy": "wrangler deploy && npm run smoke",
    "verify:postdeploy": "python3 ../../ontology/scripts/validate_openfin_120.py --mode live && python3 ../../ontology/scripts/build_finance_ontology.py && python3 ../../ontology/scripts/verify_openfin_release.py --stage postdeploy",
    "smoke": "python3 ../../ontology/scripts/smoke_finance_mcp.py",
    "test": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "agents": "^0.12.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260418.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.43.0"
  }
}
